# Django Settings
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# 通过局域网 IP / 域名 / 反向代理访问时，把完整来源加到这里（逗号分隔，含协议）
# CSRF_TRUSTED_ORIGINS=http://192.168.1.10:8000

# Database Settings
DB_ENGINE=django.db.backends.postgresql
DB_NAME=teaching_space
DB_USER=postgres
DB_PASSWORD=your-database-password
DB_HOST=localhost
DB_PORT=5432

# Redis Settings (for Celery)
REDIS_URL=redis://localhost:6379/0
# Run Celery tasks inline without a broker (default in DEBUG);
# set to False once a Redis broker + worker are running
CELERY_ALWAYS_EAGER=

# Email Settings
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-email-password

# Sentry (Error Tracking)
SENTRY_DSN=

# Social Auth (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# AI/LLM Configuration (multi-provider)
# Active provider: anthropic (default) | deepseek
AI_PROVIDER=anthropic
# Optional model override for the active provider
AI_MODEL=

# Anthropic (official or a compatible proxy)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
# Optional: custom API endpoint (e.g. an Anthropic-compatible proxy)
ANTHROPIC_BASE_URL=

# DeepSeek (Anthropic-compatible endpoint). Token comes from the
# environment variable `deepseek_Api`:
#   deepseek_Api=sk-xxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic
DEEPSEEK_MODEL=deepseek-flash

AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.7
AI_CACHE_ENABLED=True
AI_COST_LIMIT_DAILY=50.00

# AI Harness 角色→模型路由（DeepSeek-harness 模式）
# planner=推理规划（大纲/题型分布） worker=内容生成 grader=评分校验
# 留空则回退到当前 provider 的默认模型
AI_PLANNER_MODEL=deepseek-reasoner
AI_WORKER_MODEL=deepseek-flash
AI_GRADER_MODEL=
# 主模型失败时的回退链（逗号分隔）
AI_FALLBACK_MODELS=

# Video Generation Configuration
MANIM_QUALITY=medium
MANIM_OUTPUT_DIR=media/videos
FFMPEG_PATH=/usr/bin/ffmpeg
VIDEO_STORAGE_BACKEND=local
S3_BUCKET_NAME=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
CDN_URL=

# Code Execution Backend: subprocess (default) or docker (full isolation;
# requires the sandbox image: docker build -f docker/sandbox/Dockerfile -t teaching-space-sandbox .)
CODE_EXECUTION_BACKEND=subprocess

# Jupyter kernel sessions (learning class notebook)
# local = dev only (full Python); docker = production (requires the kernel image:
# docker build -f docker/kernel/Dockerfile -t teaching-space-kernel .)
JUPYTER_KERNEL_BACKEND=local
JUPYTER_KERNEL_IMAGE=teaching-space-kernel
JUPYTER_KERNEL_IDLE_TIMEOUT=900
JUPYTER_MAX_KERNELS=20
JUPYTER_EXECUTE_TIMEOUT=15

