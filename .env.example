# Django Settings
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Settings
DB_ENGINE=django.db.backends.postgresql
DB_NAME=teaching_space
DB_USER=postgres
DB_PASSWORD=your-database-password
DB_HOST=localhost
DB_PORT=5432

# Redis Settings (for Celery)
REDIS_URL=redis://localhost:6379/0
# Run Celery tasks inline without a broker (default in DEBUG);
# set to False once a Redis broker + worker are running
CELERY_ALWAYS_EAGER=

# Email Settings
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-email-password

# Sentry (Error Tracking)
SENTRY_DSN=

# Social Auth (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# AI/LLM Configuration
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
# Optional: custom API endpoint (e.g. an Anthropic-compatible proxy)
ANTHROPIC_BASE_URL=
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.7
AI_CACHE_ENABLED=True
AI_COST_LIMIT_DAILY=50.00

# Video Generation Configuration
MANIM_QUALITY=medium
MANIM_OUTPUT_DIR=media/videos
FFMPEG_PATH=/usr/bin/ffmpeg
VIDEO_STORAGE_BACKEND=local
S3_BUCKET_NAME=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
CDN_URL=

# Code Execution Backend: subprocess (default) or docker (full isolation;
# requires the sandbox image: docker build -f docker/sandbox/Dockerfile -t teaching-space-sandbox .)
CODE_EXECUTION_BACKEND=subprocess

